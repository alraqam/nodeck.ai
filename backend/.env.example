PROJECT_NAME=NoDeck
API_V1_STR=/api/v1
BACKEND_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Honour X-Forwarded-For when rate limiting the public share route.
# Enable ONLY where this API is unreachable except through the Next app
# or a proxy - the header is client-controlled, so trusting it on a
# directly-reachable API lets anyone forge an identity per request and
# walk past the limiter. Leaving it false is safe but means every
# server-rendered share page shares one bucket.
TRUST_PROXY_HEADERS=false

# Database. Use 127.0.0.1 rather than localhost: on Windows "localhost" can
# resolve to ::1 first and asyncpg will not fall back to IPv4.
POSTGRES_SERVER=127.0.0.1
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=nodeck
# The test suite creates and uses this separately, so it never races the
# running job worker for rows.
POSTGRES_TEST_DB=nodeck_test
POSTGRES_PORT=5432
SQL_ECHO=false

# Auth. Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change_me
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# AI. The app boots without a key; only /analysis endpoints need it.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
ANTHROPIC_MAX_TOKENS=16000
